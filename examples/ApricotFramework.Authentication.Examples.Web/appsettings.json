{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    // Duende's public demo provider. The client below is the one it documents for anyone to use, so
    // "secret" is a published test value and not a credential. In a real service the secret comes from
    // an environment variable or a secrets manager, as Authentication__Client__ClientSecret.
    "Authority": "https://demo.duendesoftware.com",
    "ValidAudiences": [ "api" ],
    "Client": {
      "ClientId": "m2m",
      "ClientSecret": "secret",
      "Scopes": [ "api" ]
    }
  }
}
