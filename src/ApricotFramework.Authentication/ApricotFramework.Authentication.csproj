<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Zero-dependency OAuth 2.0 outbound authentication for .NET: access tokens obtained by client credentials or by RFC 8693 token exchange, fetched through OpenID Connect discovery, cached per subject until shortly before they expire, and coalesced so concurrent callers make one token request rather than many.</Description>
    <PackageTags>oauth2;openid-connect;client-credentials;token-exchange;rfc8693;authentication;jwt;service-to-service</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ApricotFramework.Authentication.Abstractions/ApricotFramework.Authentication.Abstractions.csproj" />
  </ItemGroup>

</Project>
